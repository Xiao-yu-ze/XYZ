.cxx/

# ---- Local machine configuration (never commit) ----
local.properties
.idea/
.DS_Store

# ---- Scratch / heavy local-only directories ----
# _toolchain holds the JDK + Android SDK downloaded for headless builds (~1.9 GB)
_toolchain/
# _probe holds adb screenshots and throwaway device scripts
_probe/
_hosts-backup.txt

# ---- MaaPVZ assets are NOT committed (see tools/sync-maapvz-assets.ps1) ----
# The template images are screenshots of a commercial game whose artwork remains the
# property of the game publisher; MaaPVZ's own README grants them non-commercial use
# only. Rather than redistribute them, run the sync script to copy them out of a local
# MaaPVZ install. The OCR models are large binaries for the same reason.
#
# The game image folders sit directly at the assets root, mirroring MaaPVZ's
# resource/image/ layout so pipeline JSON paths resolve unchanged
# (e.g. "Endless/无尽挑战.png" opens as-is).
app/src/main/assets/coords.json
app/src/main/assets/ocr/
app/src/main/assets/jobs/
app/src/main/assets/pipeline/

