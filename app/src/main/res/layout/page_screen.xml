<?xml version="1.0" encoding="utf-8"?>
<!--
  第 1 页：屏。

  管 Shizuku 连接、渠道选择、建屏/停屏、导出日志。
  预览不在这里 —— 它固定在主界面上方，所有页共用，翻页不影响。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_screen_title" />

        <!-- Shizuku 状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvShizukuState"
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/shizuku_unknown" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartShizuku"
                style="@style/AppButton.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_start_shizuku" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="" />

        <TextView
            android:id="@+id/tvProgress"
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="" />

        <!-- 用 Outline 而不是 Quiet：Quiet 是纯文字按钮、没有背景，
             在这一页上看起来不像能点的东西。 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/AppButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_stop" />

        <!-- 渠道选择：默认自动识别，认不出来才手动选。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_channel" />

            <Spinner
                android:id="@+id/spChannel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <EditText
            android:id="@+id/etCustomPackage"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_custom_package"
            android:inputType="text"
            android:singleLine="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvChannelHint"
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVdStart"
                style="@style/AppButton.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_vd_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVdStop"
                style="@style/AppButton.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_vd_stop" />
        </LinearLayout>

        <!-- 游戏帧率上限。
             游戏在虚拟屏里读 Display.getRefreshRate() 决定渲染节奏，
             所以这项实际是设虚拟屏刷新率。改完要重新建屏才生效。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_game_fps" />

            <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/label_game_fps_fixed"
            android:textSize="14sp" />
        </LinearLayout>

        <!-- 出问题时最重要的一件事：把日志弄出来。 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportLog"
            style="@style/AppButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/btn_export_log" />

        <!-- 调试截图会自己长大（ocr_fail 曾到 667MB），这里给一键清理；
             只删截图，脚本和 .log 文本日志都留着。 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCleanCache"
            style="@style/AppButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_clean_cache" />

        <TextView
            android:id="@+id/tvLogHint"
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_export_log" />

    </LinearLayout>
</ScrollView>
