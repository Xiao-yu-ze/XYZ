<?xml version="1.0" encoding="utf-8"?>
<!--
  第 4 页：编辑。

  和「脚本」页分开：那一页只管运行，这一页只管看/改结构。
  一个页面同时做两件事，操作按钮和节点列表会互相挤。

  上半部分选脚本 + 过滤，下半部分是节点卡片列表。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView
        style="@style/Text.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_title" />

    <!-- 脚本选择 + 节点过滤 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/spEditorScript"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <EditText
            android:id="@+id/etNodeFilter"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:hint="@string/editor_filter_hint"
            android:inputType="text"
            android:singleLine="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEditorSummary"
        style="@style/Text.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="" />

    <!-- 节点列表。用 RecyclerView 而不是往 LinearLayout 里塞上百个 view ——
         真实脚本 101 个节点，一次性 inflate 会明显卡顿。 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNodes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</LinearLayout>
