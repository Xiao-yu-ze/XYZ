<?xml version="1.0" encoding="utf-8"?>
<!--
  一个节点卡片。

  折叠时只显示「节点名 + 识别类型 · 动作类型」一行摘要 ——
  脚本动辄上百个节点，全部展开根本没法看。
  点一下展开，把这一次识别的全部参数摊开。

  展开区是空的，参数行由 EditorPage 按节点实际内容动态生成 ——
  不同识别类型的参数完全不同（模板匹配看分数和 ROI，OCR 看期望文本），
  写死在 XML 里会变成一大堆 visibility 开关。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_node_card"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- 标题行：整行可点，用来展开/收起 -->
    <LinearLayout
        android:id="@+id/nodeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNodeName"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <!-- 摘要：识别类型 · 动作类型。折叠状态下也要能判断这个节点在干什么。 -->
            <TextView
                android:id="@+id/tvNodeSummary"
                style="@style/Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNodeChevron"
            style="@style/Text.RowAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/chevron_collapsed"
            android:textColor="@color/ink_faint" />
    </LinearLayout>

    <!-- 展开后的参数区。内容由代码填充。 -->
    <LinearLayout
        android:id="@+id/nodeBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>
