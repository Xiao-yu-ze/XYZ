<?xml version="1.0" encoding="utf-8"?>
<!--
  第 3 页：脚本编辑器。

  只做一件事 —— **改**。运行在第 2 页，看画面在第 1 页。
  原来这一页同时塞了保存/另存为/运行/停止/添加五个按钮，光按钮就占掉
  半屏，字段全被挤到看不见。现在只留「保存」和「添加动作」并排一行。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="10dp">

    <!-- 一行：保存 + 添加动作。
         保存不设成主色，因为它是"顺手做一下"的动作；主色留给列表里的运行。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZjsSave"
            style="@style/AppButton.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/zjs_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZjsAddAction"
            style="@style/AppButton.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/zjs_add_action" />
    </LinearLayout>

    <!-- 当前脚本名 + 动作数 + 校验提示。
         原来的「脚本动作（自动精灵格式）」大标题去掉了 —— 这一页只干这一件事，
         标题只是占地方；这行摘要反而有信息。 -->
    <TextView
        android:id="@+id/tvZjsSummary"
        style="@style/Text.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/zjs_loading" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvZjsActions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</LinearLayout>
