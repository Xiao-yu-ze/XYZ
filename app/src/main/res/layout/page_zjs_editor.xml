<?xml version="1.0" encoding="utf-8"?>
<!--
  第 3 页：脚本编辑器。

  只做一件事 —— **改**。运行在第 2 页，看画面在第 1 页。
  原来这一页同时塞了保存/另存为/运行/停止/添加五个按钮，光按钮就占掉
  半屏，字段全被挤到看不见。现在只留「保存」和「添加动作」并排一行。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="10dp">

    <!-- 一行：保存 + 添加动作。
         保存不设成主色，因为它是"顺手做一下"的动作；主色留给列表里的运行。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZjsSave"
            style="@style/AppButton.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/zjs_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZjsAddAction"
            style="@style/AppButton.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/zjs_add_action" />

    </LinearLayout>

    <!-- 下潜导航（监听 / 运行多个动作）。
         进去以后必须能回来 —— 原来只有 popNav() 这个函数，界面上**没有任何入口**
         调用它，进了监听槽位就出不来，只能去第 2 页重开脚本。 -->
    <LinearLayout
        android:id="@+id/llZjsNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZjsUp"
            style="@style/AppButton.Outline"
            android:layout_width="wrap_content"
            android:minWidth="0dp"
            android:layout_height="wrap_content"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/zjs_back" />

        <TextView
            android:id="@+id/tvZjsPath"
            style="@style/Text.Hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 当前脚本名 + 动作数 + 校验提示。
         原来的「脚本动作（脚本格式格式）」大标题去掉了 —— 这一页只干这一件事，
         标题只是占地方；这行摘要反而有信息。 -->
    <TextView
        android:id="@+id/tvZjsSummary"
        style="@style/Text.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/zjs_loading" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvZjsActions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</LinearLayout>
