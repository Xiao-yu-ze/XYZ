<?xml version="1.0" encoding="utf-8"?>
<!--
  第 3 页：自动精灵格式的脚本浏览。

  和 MaaFramework 那套分开放：两套格式完全不通，
  混在一个列表里会让人分不清手上这个脚本到底是哪种。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        style="@style/Text.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/zjs_editor_title" />

    <TextView
        android:id="@+id/tvZjsSummary"
        style="@style/Text.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/zjs_loading" />

    <!-- 保存 / 另存为。改了不保存等于白改，所以放在列表上方一直可见。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZjsSave"
            style="@style/AppButton.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/zjs_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZjsSaveAs"
            style="@style/AppButton.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/zjs_save_as" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvZjsActions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</LinearLayout>