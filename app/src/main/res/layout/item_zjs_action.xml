<?xml version="1.0" encoding="utf-8"?>
<!--
  脚本格式动作卡片。

  一行折叠、点开看全部字段 —— 和 参考管线 那套一致。
  真实脚本上百个动作，全展开的话一屏放不下两个。
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- 折叠行：序号 + 标签 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvActionIndex"
                style="@style/Text.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="28dp"
                android:text="1" />

            <TextView
                android:id="@+id/tvActionLabel"
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="点击" />

            <TextView
                android:id="@+id/tvActionBadge"
                style="@style/Text.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="" />
        </LinearLayout>

        <!-- 展开区：字段行。
             淡底 + 内缩，让「卡片头」和「字段身」在视觉上分开 ——
             原来全白一片，十几行看不出结构。 -->
        <!--
          运行进度条 + 执行次数。

          ## 为什么要画在这一条上

          用户跑脚本时最想知道的是"现在跑到哪儿了、跑了几轮"。
          只在顶部显示一句话是不够的：脚本有上百条动作，
          必须让**正在跑的那一条自己亮起来**，否则眼睛要在列表和状态行之间来回找。

          进度按这条动作的延时/时长/重复次数估算（见 ZExecutor.estimateMs）；
          估算不出来的（候选等待）走不确定进度。
        -->
        <LinearLayout
            android:id="@+id/llActionProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbAction"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="1000" />

            <TextView
                android:id="@+id/tvActionRunCount"
                style="@style/Text.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="11sp"
                tools:text="第 3 次" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llActionFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F7FAF6"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>