<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面布局。

  结构：一屏之内按「状态卡 → 准备工作 → 运行 → 调试工具」分区。
  每个分区有标题 + 一句话说明，按钮按主次区分：
    主要动作  -> 实心（MaterialButton，背景色填充）
    次要动作  -> 描边
    调试动作  -> 描边 + 更小
  这样"该点哪个"一眼能看出来，而不是一排等权重的按钮。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ==================== 标题 ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_title"
            android:textColor="#1A1A1A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ui_subtitle"
            android:textColor="#8A8A8E"
            android:textSize="13sp" />

        <!-- ==================== 状态卡 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_status_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvShizukuState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#1A000000" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#5A5A5E"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- ==================== 准备工作 ==================== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_permissions" />

        <TextView
            style="@style/SectionHint"
            android:text="@string/hint_permissions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShizuku"
            style="@style/ActionButton.Primary"
            android:text="@string/btn_authorise_shizuku" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOverlay"
            style="@style/ActionButton.Secondary"
            android:text="@string/btn_allow_overlay" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccessibility"
            style="@style/ActionButton.Secondary"
            android:text="@string/btn_enable_accessibility" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotifications"
            style="@style/ActionButton.Secondary"
            android:text="@string/btn_allow_notifications" />

        <!-- ==================== 运行 ==================== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_run" />

        <TextView
            style="@style/SectionHint"
            android:text="@string/hint_run" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartShizuku"
            style="@style/ActionButton.Primary"
            android:text="@string/btn_start_shizuku" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartFallback"
            style="@style/ActionButton.Secondary"
            android:text="@string/btn_start_fallback" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowOverlay"
            style="@style/ActionButton.Secondary"
            android:text="@string/btn_show_panel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/ActionButton.Danger"
            android:text="@string/btn_stop" />

        <!-- ==================== 调试工具 ==================== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_tools" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyDry"
            style="@style/ActionButton.Primary"
            android:text="@string/btn_verify_dry" />

        <TextView
            style="@style/SectionHint"
            android:text="@string/hint_verify" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyRun"
            style="@style/ActionButton.Secondary"
            android:text="@string/btn_verify_run" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProbe"
            style="@style/ActionButton.Secondary"
            android:text="@string/btn_probe" />

        <TextView
            style="@style/SectionHint"
            android:text="@string/hint_probe" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrabFrame"
            style="@style/ActionButton.Secondary"
            android:text="@string/btn_grab_frame" />

        <TextView
            style="@style/SectionHint"
            android:text="@string/hint_grab_frame" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
