<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面：**预览固定，功能滑动**。

  ## 为什么是这个结构

  用户的要求：每个功能单独一页，但每一页都要能看到虚拟屏，功能放在下面，
  左右滑动切换，且切换不能影响预览。

  所以布局是垂直两段：
    上段 = 预览（不随翻页变化，始终可见、始终在收帧）
    下段 = ViewPager2（三页：屏 / 脚本 / 诊断）

  预览不能放进 ViewPager 里 —— 那样翻页时它会被销毁重建，
  画面会黑一下，而且采集要重新开始。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">

    <!-- ==================== 上段：预览（固定） ==================== -->

    <TextView
        style="@style/Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_title" />

    <!-- 预览面板。16:9 自适应，圆角 + 描边。
         描边用 foreground，因为 View.draw 的顺序是
         背景 → 自身 → 子控件 → 前景，写在 background 里会被画面盖掉。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal">

        <com.pvz2.auto.ui.AspectFrameLayout
            android:id="@+id/flPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_preview"
            android:clipToOutline="true"
            android:foreground="@drawable/bg_preview_stroke">

            <ImageView
                android:id="@+id/ivVdPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/vd_preview_desc"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvPreviewEmpty"
                style="@style/Text.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/vd_preview_empty"
                android:textColor="@color/ink_faint" />
        </com.pvz2.auto.ui.AspectFrameLayout>
    </FrameLayout>

    <!-- 预览下面一行：左边状态，右边帧率。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvVdState"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vd_state_idle" />

        <TextView
            android:id="@+id/tvVdFps"
            style="@style/Text.Hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVdDetail"
        style="@style/Text.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="" />

    <!-- 说明预览可点。没有这句，用户根本不会想到去点画面。 -->
    <TextView
        style="@style/Text.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vd_preview_tap_hint" />

    <!-- ==================== 下段：功能页（可滑动） ==================== -->

    <!-- ★ 必须写完整包名。LayoutInflater 对没有包名的标签会套上 `android.view.`
         前缀，于是去找 android.view.ViewPager2 —— 那个类不存在，
         启动时直接 ClassNotFoundException 闪退。 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1" />

    <!-- 页码点。三页不多，一行点足够，不占地方。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dot0"
            style="@style/Text.RowAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:text="@string/page_dot_on" />

        <TextView
            android:id="@+id/dot1"
            style="@style/Text.RowAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:text="@string/page_dot_off" />

        <TextView
            android:id="@+id/dot2"
            style="@style/Text.RowAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:text="@string/page_dot_off" />
    </LinearLayout>

</LinearLayout>
