<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating control panel. Kept deliberately small and anchored to the left edge so it
  never covers the play field. Only the title row is draggable, which leaves the
  buttons clickable.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#CC1B1B1B"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:text="@string/overlay_title"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlayStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingBottom="4dp"
        android:textColor="#B0FFFFFF"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOverlayStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/overlay_start"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOverlayStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/overlay_stop"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
