<?xml version="1.0" encoding="utf-8"?>
<!--
  第 2 页：脚本库。

  职责只有一件：**这些脚本在哪、跑哪一个**。
  编辑在第 3 页，跑在这里 —— 因为跑的时候最需要看画面（第 1 页），
  而编辑时不需要。把两者分开放，各自占满屏幕。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="10dp">

    <!-- 标题行：名字 + 数量。数量放右边，扫一眼就知道存了几个。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Text.Section 自带 marginTop=24dp（它是给页面里的大标题用的），
             放在这一行会把标题往下顶 24dp，和右边的「3 个」错成两行、
             看起来像两个不相关的文字。这里必须归零。 -->
        <TextView
            style="@style/Text.Section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:text="@string/library_title"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvLibraryCount"
            style="@style/Text.Hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:textColor="@color/ink_muted" />
    </LinearLayout>

    <!-- 导入 / 导出。
         导入是为了把别人做的脚本（或电脑上自动精灵导出的）拿进来；
         导出是为了把自己的发出去或备份 —— 文件在应用私有目录里，
         用户用文件管理器找不到，没有导出等于拿不出来。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLibraryImport"
            style="@style/AppButton.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/library_import" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLibraryExport"
            style="@style/AppButton.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/library_export" />
    </LinearLayout>

    <!-- 空态 / 运行状态。没有它的话，一个空列表看起来像坏了。 -->
    <TextView
        android:id="@+id/tvLibraryHint"
        style="@style/Text.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/library_loading" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLibrary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />
</LinearLayout>
