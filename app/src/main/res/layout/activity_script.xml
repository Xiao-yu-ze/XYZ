<?xml version="1.0" encoding="utf-8"?>
<!--
  脚本运行页。

  设计原则（用户提出：每个功能单独一页，不要拥挤）：
    · 这一页只管「跑脚本」，不放虚拟屏预览、不放诊断工具
    · 从上到下只有一条动线：选脚本 → 确认入口 → 运行 → 看状态
    · 状态区是这一页的重点：脚本跑起来后用户只能看到游戏画面，
      而画面不动有两种含义（卡死 / 正在等），必须靠这一页区分
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/script_title" />

        <TextView
            style="@style/Text.Hint"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/script_subtitle" />

        <!-- 脚本列表。点一行选中，选中的那行会高亮。 -->
        <LinearLayout
            android:id="@+id/scriptList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swDryRun"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/script_dry_run" />
        </LinearLayout>

        <TextView
            style="@style/Text.Hint"
            android:layout_marginTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/script_dry_run_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScriptRun"
                style="@style/AppButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/script_run" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScriptStop"
                style="@style/AppButton.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/script_stop" />
        </LinearLayout>

        <!-- 状态区。这是本页最重要的部分。 -->
        <TextView
            style="@style/Text.Section"
            android:layout_marginTop="28dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/script_status_title" />

        <TextView
            android:id="@+id/tvScriptMessage"
            style="@style/Text.Body"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/script_idle" />

        <TextView
            android:id="@+id/tvScriptProgress"
            style="@style/Text.Hint"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="" />

        <!-- 命中统计固定高度，避免数字变化时整页跳动。 -->
        <TextView
            android:id="@+id/tvScriptHits"
            style="@style/Text.Hint"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:minLines="4"
            android:text="" />

    </LinearLayout>
</ScrollView>
