<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      用 Material 主题，因为 styles.xml 里的按钮样式继承
      Widget.MaterialComponents.Button。继承 AppCompat 主题会导致
      按钮找不到这些属性而报错。

      刻意不跟随深色模式：界面用的是固定浅色配色（#F5F6F8 底 + 白卡），
      跟随 DayNight 反而会出现"浅色卡片贴在深色底上"的割裂。等界面颜色
      都走主题属性后再开。
    -->
    <style name="Theme.Pvz2Auto" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#2C6E49</item>
        <item name="colorPrimaryVariant">#1F4F35</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#2C6E49</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">#F5F6F8</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
