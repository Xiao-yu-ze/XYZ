<?xml version="1.0" encoding="utf-8"?>
<!--
  配色 —— 取自游戏本身的世界观，但按"工具"的克制度重做。

  为什么这样选：这个 App 是**围着游戏转的工具**，不是游戏本身。
  所以不去模仿游戏的卡通描边，而是把游戏里的几种"物质颜色"降饱和后
  当成一套工作色：
    草坪绿  → 主色（深一档，避免和游戏画面抢眼）
    阳光金  → 强调/进度（唯一的暖色，用在"已完成"和进度上）
    种子包棕 → 分隔线、序号底（安静的辅助色）
    僵尸灰  → 次要文字（冷灰，带一点绿调，不脏）

  刻意避开的两种 AI 默认脸：
    · 暖奶油底(#F4F1EA) + 赤陶色      —— 和这个主题无关
    · 纯黑底 + 荧光绿                  —— 工具类 App 晚上更刺眼，且太"黑客感"
-->
<resources>

    <!-- ==================== 基底 ==================== -->
    <!-- 页面底：极浅的绿灰纸感，比纯灰多一点色温，但不至于发黄 -->
    <color name="paper">#EDF1E9</color>
    <!-- 卡片面：纯白，靠描边和阴影和底色分开 -->
    <color name="surface">#FFFFFF</color>
    <!-- 卡片描边：冷绿灰 -->
    <color name="hairline">#DCE3D8</color>

    <!-- ==================== 墨色 ==================== -->
    <!-- 正文：近黑带绿调，比纯黑柔和 -->
    <color name="ink">#16241C</color>
    <!-- 次要文字 -->
    <color name="ink_muted">#5C6B60</color>
    <!-- 弱化文字 / 占位 -->
    <color name="ink_faint">#8B978E</color>

    <!-- ==================== 主色（草坪绿） ==================== -->
    <color name="lawn">#2F6B4A</color>
    <color name="lawn_pressed">#245539</color>
    <color name="lawn_tint">#E4EDE7</color>
    <color name="on_lawn">#FFFFFF</color>

    <!-- ==================== 强调（阳光金） ==================== -->
    <!-- 只用在"已完成"、进度、序号高亮上。是整屏唯一的暖色。 -->
    <color name="sun">#C8871F</color>
    <color name="sun_tint">#FBF1DC</color>

    <!-- ==================== 辅助（种子包棕） ==================== -->
    <color name="bark">#8A6A45</color>
    <color name="bark_tint">#F0E9DF</color>

    <!-- ==================== 状态色 ==================== -->
    <!-- 就绪 -->
    <color name="state_ok">#3E8E5A</color>
    <!-- 待办 / 未授权 -->
    <color name="state_todo">#C8871F</color>
    <!-- 错误 / 停止 -->
    <color name="state_bad">#B4443A</color>

    <!-- ==================== 分隔 ==================== -->
    <color name="divider">#E6EBE3</color>

</resources>
