<?xml version="1.0" encoding="utf-8"?>
<!--
  界面样式。

  目标：让「该点哪个」一眼可见，而不是一排等权重按钮。
    主按钮   实心深色    —— 当前该做的主要动作
    次按钮   描边浅色    —— 可选动作
    危险按钮 描边红色    —— 停止
  另加分区标题与说明文字两个文本样式。
-->
<resources>

    <!-- ==================== 分区标题 ==================== -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ==================== 说明文字 ==================== -->
    <style name="SectionHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">#8A8A8E</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- ==================== 按钮基类 ==================== -->
    <style name="ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- 主要动作：实心 -->
    <style name="ActionButton.Primary">
        <item name="backgroundTint">#2C6E49</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <!-- 次要动作：描边 -->
    <style name="ActionButton.Secondary">
        <item name="backgroundTint">#FFFFFFFF</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="strokeColor">#D8DAE0</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 危险动作：红色描边 -->
    <style name="ActionButton.Danger">
        <item name="backgroundTint">#FFFFFFFF</item>
        <item name="android:textColor">#C0392B</item>
        <item name="strokeColor">#E8B4AE</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
