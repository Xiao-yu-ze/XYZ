    <string name="btn_start_shizuku">启动（Shizuku）</string>
    <string name="btn_stop">停止</string>

    <string name="hint_run">「启动（Shizuku）」是唯一的运行方式：截图、注入、建虚拟屏全部在 shell 身份那一侧完成。</string>

    <!-- ==================== 主界面 · 调试工具 ==================== -->

    <string name="hint_tap_x">X（默认 640）</string>
    <string name="hint_tap_y">Y（默认 360）</string>
    <string name="test_tap_no_display">虚拟屏未启动（displayId ≤ 0），先建屏再测。</string>
    <string name="test_tap_running">正在向 display=%1$d 注入点击…</string>
    <string name="btn_test_tap">虚拟屏 · 测试点击</string>
    <string name="hint_test_tap">在虚拟屏正中点一下，不经过识别和脚本，只验证"事件能不能进到那块屏"。结果显示在按钮下方：系统接受=注入通道通；被拒=窗口不在那块屏上，或那块屏不可触摸。</string>

