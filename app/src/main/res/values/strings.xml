    <!-- ==================== 主界面 · 准备工作 ==================== -->
    <string name="btn_authorise_shizuku">授权 Shizuku</string>
    <string name="btn_allow_notifications">授予通知权限</string>

    <!-- ==================== 主界面 · 虚拟屏 ==================== -->
    <string name="label_channel">渠道</string>
    <string name="hint_custom_package">输入包名，例如 com.popcap.pvz2cthdop</string>
    <string name="channel_custom">自定义包名…</string>
    <string name="channel_detected">已自动识别：%1$s（%2$s）</string>
    <string name="channel_not_found">没有在设备上找到任何已知渠道的游戏，请手动选择或输入包名。</string>
    <string name="channel_picked">将启动：%1$s（%2$s）</string>
    <string name="channel_custom_invalid">包名不能为空，且只能包含字母、数字、点和下划线。</string>
    <string name="btn_vd_start">在虚拟屏启动游戏</string>
    <string name="btn_vd_stop">停止并释放</string>
    <string name="hint_virtual_display">建一块 1280×720 的虚拟屏，把游戏搬到里面运行。游戏不会占用你的物理屏幕，你在本界面就能看到它的画面。</string>
    <string name="vd_state_idle">虚拟屏未启动</string>
    <!-- running 但还没拿到画面/displayId 时的过渡态。不给文案的话，默认 message 会把
         界面说成"未启动"，与实际正在建屏矛盾。 -->
    <string name="vd_building">正在启动…</string>
    <string name="vd_preview_desc">虚拟屏实时画面</string>
    <!-- 标题行只讲"在跑 + 多大"。displayId 是系统分配的、每次都不一样
         （用户看到过 59、47 之类），对使用毫无意义，只放在导出日志里备查。 -->
    <string name="vd_running_format">运行中 · %1$d×%2$d</string>
    <string name="vd_preview_empty">尚未启动</string>
    <string name="vd_preview_waiting">已建屏，等待画面…</string>
    <string name="vd_live_frames">%1$d fps</string>
    <string name="vd_no_content">虚拟屏已建，但取不到画面 —— 游戏可能没搬上去，或还没开始渲染。</string>
    <string name="vd_stopped">虚拟屏已停止</string>
    <string name="vd_failed_format">建失败：%1$s</string>
    <string name="btn_export_log">导出日志</string>
    <string name="hint_export_log">把关键日志存成文件并分享出来，排查问题用。不包含任何个人信息。</string>
    <string name="log_export_ok">日志已保存：%1$s</string>
    <string name="log_export_fail">导出失败：%1$s</string>
    <string name="log_share_title">分享日志</string>

    <string name="hint_permissions">顺序做完这两项。第一项是必须的；第二项只在需要常驻通知时才有意义。\n全部操作都在本界面里完成 —— 没有悬浮窗，也不依赖无障碍服务。</string>

