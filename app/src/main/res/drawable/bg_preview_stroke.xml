<?xml version="1.0" encoding="utf-8"?>
<!--
  预览面板的描边。由 flPreview 的 android:foreground 承载。

  ## 为什么不做在背景里
  View 的绘制顺序是「背景 → 自身内容 → 子控件 → 前景」。
  背景在子控件之前画，所以画面一进来就会把描边整圈盖掉。
  前景在 dispatchDraw() 之后画，永远压在最上面 —— 这才是描边该待的位置。

  ## 为什么是透明填充
  foreground 会盖在画面之上。必须完全透明，否则会把画面蒙住。
  只留 1dp 的边，且颜色是发白的（半透明白），
  这样无论底下是黑屏、亮色游戏画面还是彩色草地，那道边都看得见。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/transparent" />

    <corners android:radius="14dp" />

    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />

</shape>
