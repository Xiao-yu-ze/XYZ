<?xml version="1.0" encoding="utf-8"?>
<!--
  选中态的卡片背景。

  和 bg_node_card 唯一的区别是描边换成强调色、加一点浅底。
  之前脚本列表用的是裸 TextView —— 和页面底色完全一样，
  看不出"这是一个可以点的条目"，更看不出哪个被选中了。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#EAF3E6" />

    <corners android:radius="10dp" />

    <stroke
        android:width="1.5dp"
        android:color="@color/state_ok" />

</shape>
