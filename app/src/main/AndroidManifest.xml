<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============================ Permissions ============================ -->

    <!-- Lets the Shizuku app hand our process the Shizuku binder.
         Declared automatically by the :provider AAR, repeated here for clarity. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 注意：不再声明 SYSTEM_ALERT_WINDOW。
         悬浮面板已移除 —— 开始/暂停/停止等所有操作都在 App 界面内完成。
         虚拟屏方案下游戏跑在副屏，本界面留在前台也不会遮挡它，所以不需要悬浮窗。 -->

    <!-- The automation loop runs inside a foreground service.
         Android 14 requires one permission per declared foreground service type.
         只有 specialUse 一种：MediaProjection 降级路线已整体移除。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- API 33+: the foreground service notification is only shown if this is granted -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pvz2Auto">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hosts the capture -> match -> tap loop.

             foregroundServiceType 只有 specialUse 一种，因为只剩 Shizuku 一条路
             （MediaProjection + 无障碍的降级方案已按需求移除）。
             specialUse 还需要下面的 <property>（android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE）。 -->
        <service
            android:name=".service.AutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous_on_device_screen_automation_loop" />
        </service>

        <!-- 无障碍服务（Pvz2AccessibilityService）已移除 —— 它是 MediaProjection 降级方案的
             触控后端，现在只走 Shizuku 的 `input tap/swipe`，不再需要无障碍。
             相应地 res/xml/accessibility_service_config.xml 也已删除。 -->

        <!-- Official Shizuku registration. Authority must be "${applicationId}.shizuku"
             and the INTERACT_ACROSS_USERS_FULL permission keeps other apps out.
             See Shizuku-API README -> "Acquire the Binder" -> "Shizuku". -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- NOTE: com.pvz2.auto.shizuku.Pvz2UserService is intentionally NOT declared here.
             Shizuku starts it inside its own app_process (as shell/root), it is not an
             android.app.Service and is never bound through the ActivityManager. -->
        <!-- 分享日志用。authorities 带包名，避免与其它应用冲突。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    
    
    </application>

</manifest>
